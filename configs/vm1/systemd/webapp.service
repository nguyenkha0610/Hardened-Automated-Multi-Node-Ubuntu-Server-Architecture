[Unit]
Description=Webapp (Flask/gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=webapp
Group=webapp
WorkingDirectory=/opt/webapp
EnvironmentFile=/etc/webapp/app.env
ExecStart=/opt/webapp/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
